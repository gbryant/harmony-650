From b039940ded0a041d2175eb4fdd8dd058fdb93610 Mon Sep 17 00:00:00 2001
From: Gregory Bryant <gregory.r.bryant@gmail.com>
Date: Mon, 26 Oct 2026 15:24:25 -0700
Subject: [PATCH 3/5] Follow Logitech's arch 14 update sequence in
 --write-arch14-fw

Taken from the Windows Harmony Remote 7.7.0 updater
(UpdateHidService.writeApplicationFirmware, architecture 14): restart
config at entry point 9 unless in safe mode, RAM[0] = 0, invalidate,
erase, write at 0x0, verify, then RAM[0] = 2 so the bootloader installs
the image on the next reset.

Also check the header's 24-bit size field (image size - 8) and compute
the checksum over the exact image length, as Logitech does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EuLqkrUHyeLdQZcZbCMFB3
---
 concordance/concordance.c |  4 +-
 libconcord/libconcord.cpp | 97 +++++++++++++++++++++++++--------------
 libconcord/libconcord.h   | 12 +++--
 libconcord/remote.cpp     |  6 +++
 libconcord/remote.h       |  1 +
 5 files changed, 79 insertions(+), 41 deletions(-)

diff --git a/concordance/concordance.c b/concordance/concordance.c
index 35b1e38..a051f27 100644
--- a/concordance/concordance.c
+++ b/concordance/concordance.c
@@ -888,8 +888,8 @@ int write_arch14_fw(struct options_t *options, char *file_name,
     }
 
     int err;
-    printf("Checking %s (0x%zX bytes, header version bytes %02X %02X)\n",
-           file_name, size, size > 7 ? img[6] : 0, size > 7 ? img[7] : 0);
+    printf("Checking %s (0x%zX bytes, version byte 0x%02X)\n",
+           file_name, size, size > 7 ? img[7] : 0);
     if ((err = write_arch14_firmware(img, size, 1, NULL, NULL))) {
         return err;
     }
diff --git a/libconcord/libconcord.cpp b/libconcord/libconcord.cpp
index e57610a..5d3807f 100644
--- a/libconcord/libconcord.cpp
+++ b/libconcord/libconcord.cpp
@@ -1422,7 +1422,29 @@ int read_flash_range_from_remote(uint32_t addr, uint32_t size, uint8_t **out,
 #define ARCH14_FW_ADDR 0x000000
 #define ARCH14_FW_MAX_SIZE 0x020000
 #define ARCH14_SECTOR_SIZE 0x010000
+#define ARCH14_FW_HEADER_SIZE 8
 
+/* Write a byte to remote RAM and read it back */
+static int _write_verify_ram(CRemote *r, uint8_t addr, uint8_t value)
+{
+    uint8_t v = value;
+    if (r->WriteRam(addr, 1, &v))
+        return LC_ERROR_WRITE;
+    if (r->ReadRam(addr, 1, &v))
+        return LC_ERROR_READ;
+    return v == value ? 0 : LC_ERROR_VERIFY;
+}
+
+/*
+ * Mirrors Logitech's updater (UpdateHidService.writeApplicationFirmware,
+ * region 2, architecture 14):
+ *   restart config (entry point 9) unless already in safe mode
+ *   RAM[0] = 0
+ *   invalidate flash, erase, write image at 0x000000, read back to verify
+ *   RAM[0] = 2   (tells the bootloader a new image is waiting)
+ * The caller then resets the remote so the bootloader copies the image
+ * into internal flash at 0x9000.
+ */
 int write_arch14_firmware(const uint8_t *img, uint32_t size, int dry_run,
                           lc_callback cb, void *cb_arg)
 {
@@ -1436,60 +1458,65 @@ int write_arch14_firmware(const uint8_t *img, uint32_t size, int dry_run,
         debug("Remote is in firmware type %d", ri.fw_type);
         return LC_ERROR_UNSUPP;
     }
-    if (size < 0x10 || size > ARCH14_FW_MAX_SIZE) {
+    if (size <= 10 || size > ARCH14_FW_MAX_SIZE || (size & 1)) {
         debug("Image size 0x%X out of range", size);
         return LC_ERROR;
     }
-    /* "HG" marker, then the entry goto (0xEF opcode) at 0x0A */
-    if (img[8] != 0x48 || img[9] != 0x47 || img[0x0B] != 0xEF) {
-        debug("Image header doesn't look like an arch 14 firmware");
-        return LC_ERROR;
-    }
-
     /*
-     * Pad with 0xFF to a 256-byte boundary. Header bytes 0-1 are an XOR
-     * checksum of the 16-bit words from offset 4 to the end, seeded with
-     * 0x21, 0x43 (see _fix_magic_bytes; arch 14 starts at offset 4).
+     * Header: [0-1] checksum, [2-3] FFFF, [4-6] payload size (LE, image
+     * size minus the 8-byte header), [7] version, [8-9] "HG" marker,
+     * then the entry goto (0xEF opcode) at 0x0A.
      */
-    const uint32_t padded = (size + 0xFF) & ~0xFFu;
-    if (padded > ARCH14_FW_MAX_SIZE) {
+    const uint32_t payload = img[4] | (img[5] << 8) | (img[6] << 16);
+    if (payload + ARCH14_FW_HEADER_SIZE != size) {
+        debug("Header size field 0x%X doesn't match image size 0x%X",
+              payload + ARCH14_FW_HEADER_SIZE, size);
         return LC_ERROR;
     }
-    uint8_t *buf = new uint8_t[padded + 64];
-    memset(buf, 0xFF, padded + 64);
-    memcpy(buf, img, size);
-
+    if (img[2] != 0xFF || img[3] != 0xFF || img[8] != 0x48 || img[9] != 0x47
+        || img[0x0B] != 0xEF) {
+        debug("Image header doesn't look like an arch 14 firmware");
+        return LC_ERROR;
+    }
+    /* XOR of the 16-bit words from offset 4 to the end, seeded 0x4321 */
     uint8_t suma = 0x21, sumb = 0x43;
-    for (uint32_t i = 4; i < padded; i += 2) {
-        suma ^= buf[i];
-        sumb ^= buf[i + 1];
+    for (uint32_t i = 4; i < size; i += 2) {
+        suma ^= img[i];
+        sumb ^= img[i + 1];
     }
-    if (suma != buf[0] || sumb != buf[1]) {
+    if (suma != img[0] || sumb != img[1]) {
         debug("Header checksum %02X%02X, computed %02X%02X",
-              buf[0], buf[1], suma, sumb);
-        delete[] buf;
+              img[0], img[1], suma, sumb);
         return LC_ERROR_VERIFY;
     }
 
     if (dry_run) {
-        delete[] buf;
         return 0;
     }
 
     CRemote *r = dynamic_cast<CRemote *>(rmt);
     if (!r) {
-        delete[] buf;
         return LC_ERROR_UNSUPP;
     }
 
+    int err;
+    if (ri.fw_type != 4 && r->RestartConfig(0x09, 0x00)) {
+        return LC_ERROR;
+    }
+    if ((err = _write_verify_ram(r, 0, 0))) {
+        return err;
+    }
+    if (r->InvalidateFlash()) {
+        return LC_ERROR_INVALIDATE;
+    }
+
     const uint32_t num_sectors =
-        (padded + ARCH14_SECTOR_SIZE - 1) / ARCH14_SECTOR_SIZE;
+        (size + ARCH14_SECTOR_SIZE - 1) / ARCH14_SECTOR_SIZE;
     for (uint32_t i = 0; i < num_sectors; i++) {
         if (cb)
             cb(LC_CB_STAGE_ERASE_FLASH, i, i, num_sectors,
                LC_CB_COUNTER_TYPE_STEPS, cb_arg, NULL);
         if (r->EraseSector(ARCH14_FW_ADDR + i * ARCH14_SECTOR_SIZE)) {
-            delete[] buf;
             return LC_ERROR_ERASE;
         }
     }
@@ -1501,20 +1528,22 @@ int write_arch14_firmware(const uint8_t *img, uint32_t size, int dry_run,
         cb_arg = (void *)true;
     }
 
-    if (rmt->WriteFlash(ARCH14_FW_ADDR, padded, buf, ri.protocol, cb, cb_arg,
-                        LC_CB_STAGE_WRITE_FIRMWARE)) {
-        delete[] buf;
+    if (r->WriteFlash(ARCH14_FW_ADDR, size, img, ri.protocol, cb, cb_arg,
+                      LC_CB_STAGE_WRITE_FIRMWARE)) {
         return LC_ERROR_WRITE;
     }
 
-    if (rmt->ReadFlash(ARCH14_FW_ADDR, padded, buf, ri.protocol, true, cb,
-                       cb_arg, LC_CB_STAGE_VERIFY_FIRMWARE)) {
-        delete[] buf;
+    /* ReadFlash can copy a little past len, so pad the verify buffer */
+    uint8_t *buf = new uint8_t[size + 64];
+    memcpy(buf, img, size);
+    err = r->ReadFlash(ARCH14_FW_ADDR, size, buf, ri.protocol, true, cb,
+                       cb_arg, LC_CB_STAGE_VERIFY_FIRMWARE);
+    delete[] buf;
+    if (err) {
         return LC_ERROR_VERIFY;
     }
 
-    delete[] buf;
-    return 0;
+    return _write_verify_ram(r, 0, 2);
 }
 
 int write_safemode_to_file(uint8_t *in, uint32_t size, char *file_name)
diff --git a/libconcord/libconcord.h b/libconcord/libconcord.h
index 3fffe80..094d62f 100644
--- a/libconcord/libconcord.h
+++ b/libconcord/libconcord.h
@@ -375,12 +375,14 @@ int read_flash_range_from_remote(uint32_t addr, uint32_t size, uint8_t **out,
 /*
  * Arch 14 (Harmony 650/700) only, EXPERIMENTAL: write a raw application
  * firmware image (as decoded from Region_2.EZUpgrade) to external flash at
- * 0x000000, then read it back to verify. Does not reset the remote.
+ * 0x000000 using the same sequence as Logitech's updater, including the
+ * RAM[0] handshake, and read it back to verify. Does not reset the remote;
+ * the bootloader installs the image on the next reset.
  *
- * The image is checked first (size, 0x4847 marker, entry goto, header
- * checksum) and the remote must be in application or safe mode; any
- * failure returns before anything is erased. With dry_run set, only the
- * checks are done.
+ * The image is checked first (header size field, 0x4847 marker, entry
+ * goto, header checksum) and the remote must be in application or safe
+ * mode; any failure returns before anything is written. With dry_run set,
+ * only the checks are done.
  */
 int write_arch14_firmware(const uint8_t *img, uint32_t size, int dry_run,
                           lc_callback cb, void *cb_arg);
diff --git a/libconcord/remote.cpp b/libconcord/remote.cpp
index 3563546..b1185c2 100644
--- a/libconcord/remote.cpp
+++ b/libconcord/remote.cpp
@@ -568,6 +568,12 @@ int CRemote::EraseSector(uint32_t sector_begin)
     return HID_ReadReport(rsp, 5000);
 }
 
+int CRemote::RestartConfig(uint8_t entry_point, uint8_t configuration)
+{
+    return WriteMiscByte(entry_point, 1, COMMAND_MISC_RESTART_CONFIG,
+                         &configuration);
+}
+
 int CRemote::WriteFlash(uint32_t addr, const uint32_t len, const uint8_t *wr,
     unsigned int protocol, lc_callback cb, void *cb_arg, uint32_t cb_stage)
 {
diff --git a/libconcord/remote.h b/libconcord/remote.h
index 1808ab7..30a8378 100644
--- a/libconcord/remote.h
+++ b/libconcord/remote.h
@@ -231,6 +231,7 @@ public:
     CRemote() {};
     virtual ~CRemote() {};
     int EraseSector(uint32_t sector_begin);
+    int RestartConfig(uint8_t entry_point, uint8_t configuration);
     int Reset(uint8_t kind);
     int GetIdentity(struct TRemoteInfo &ri, struct THIDINFO &hid,
         lc_callback cb=NULL, void *cb_arg=NULL, uint32_t cb_stage=0);
