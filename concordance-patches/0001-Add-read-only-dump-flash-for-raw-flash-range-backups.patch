From 5ddb86854831351fb6f12318a17617ee434daab4 Mon Sep 17 00:00:00 2001
From: Gregory Bryant <gregory.r.bryant@gmail.com>
Date: Mon, 26 Oct 2026 14:45:50 -0700
Subject: [PATCH 1/5] Add read-only --dump-flash for raw flash range backups

Lets arch 14 (Harmony 650/700) owners back up the full firmware region,
which --dump-firmware/--dump-safemode can't reach (64KB from 0x0 only).
Write paths are unchanged, so firmware writes stay unsupported on arch 14.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 concordance/concordance.c | 71 +++++++++++++++++++++++++++++++++++++--
 libconcord/libconcord.cpp | 30 +++++++++++++++++
 libconcord/libconcord.h   | 10 ++++++
 3 files changed, 109 insertions(+), 2 deletions(-)

diff --git a/concordance/concordance.c b/concordance/concordance.c
index 0005b3d..483beb0 100644
--- a/concordance/concordance.c
+++ b/concordance/concordance.c
@@ -88,6 +88,10 @@ int set_canon(int flag)
 #define DEFAULT_FW_FILENAME "firmware.EZUp"
 #define DEFAULT_FW_FILENAME_BIN "firmware.bin"
 #define DEFAULT_SAFE_FILENAME "safe.bin"
+#define DEFAULT_FLASH_FILENAME "flash.bin"
+/* Arch 14 (650/700): everything below the config area at 0x030000 */
+#define DEFAULT_FLASH_ADDR 0x000000
+#define DEFAULT_FLASH_LEN 0x030000
 
 const char * const VERSION = "1.5";
 
@@ -98,6 +102,8 @@ struct options_t {
     int direct;
     int noreset;
     int force;
+    uint32_t flash_addr;
+    uint32_t flash_len;
 };
 
 enum {
@@ -108,6 +114,7 @@ enum {
     MODE_DUMP_FIRMWARE,
     MODE_WRITE_FIRMWARE,
     MODE_DUMP_SAFEMODE,
+    MODE_DUMP_FLASH,
     MODE_HELP,
     MODE_LEARN_IR,
     MODE_RESET,
@@ -337,6 +344,10 @@ void populate_default_filename(int mode, int binary, char **file_name)
         case MODE_DUMP_SAFEMODE:
             *file_name = (char *) strdup(DEFAULT_SAFE_FILENAME);
             break;
+
+        case MODE_DUMP_FLASH:
+            *file_name = (char *) strdup(DEFAULT_FLASH_FILENAME);
+            break;
     }
 }
 
@@ -362,6 +373,9 @@ void parse_options(struct options_t *options, int *mode, char **file_name,
         {"reset", no_argument, 0, 'r'},
         {"no-reset", no_argument, 0, 'R'},
         {"dump-safemode", optional_argument, 0, 's'},
+        {"dump-flash", optional_argument, 0, 0},
+        {"flash-addr", required_argument, 0, 0},
+        {"flash-len", required_argument, 0, 0},
         {"connectivity-test", required_argument, 0, 't'},
         {"get-time", no_argument, 0, 'k' },
         {"set-time", no_argument, 0, 'K' },
@@ -377,6 +391,8 @@ void parse_options(struct options_t *options, int *mode, char **file_name,
     (*options).direct = 0;
     (*options).force = 0;
     (*options).noreset = 0;
+    (*options).flash_addr = DEFAULT_FLASH_ADDR;
+    (*options).flash_len = DEFAULT_FLASH_LEN;
 
     *mode = MODE_UNSET;
 
@@ -392,6 +408,20 @@ void parse_options(struct options_t *options, int *mode, char **file_name,
                 (*options).force = 1;
                 break;
             }
+            if (!strcmp(long_options[option_index].name, "dump-flash")) {
+                set_mode(mode, MODE_DUMP_FLASH);
+                if (optarg != NULL)
+                    *file_name = optarg;
+                break;
+            }
+            if (!strcmp(long_options[option_index].name, "flash-addr")) {
+                (*options).flash_addr = strtoul(optarg, NULL, 0);
+                break;
+            }
+            if (!strcmp(long_options[option_index].name, "flash-len")) {
+                (*options).flash_len = strtoul(optarg, NULL, 0);
+                break;
+            }
             break;
         case 'b':
             (*options).binary = 1;
@@ -532,6 +562,9 @@ void help()
     printf("\tRead the safemode firmware from the remote and write it");
     printf(" to a file.\n\tIf no filename is psecified, safe.bin is");
     printf(" used.\n\n");
+    printf("   --dump-flash[=<filename>] [--flash-addr=N] [--flash-len=N]\n");
+    printf("\tRead a raw range of flash (read-only) and write it to a");
+    printf(" file.\n\tDefaults: flash.bin, address 0x0, length 0x30000.\n\n");
     printf("   -t, --connectivity-test <filename>\n");
     printf("\tDo a connectivity test using <filename>\n\n");
     printf("   -V, --version\n");
@@ -794,6 +827,31 @@ int dump_safemode(char *file_name, lc_callback cb, void *cb_arg)
     return 0;
 }
 
+int dump_flash(struct options_t *options, char *file_name, lc_callback cb,
+               void *cb_arg)
+{
+    uint8_t * flash = 0;
+    int err = 0;
+
+    printf("Reading 0x%06X bytes from 0x%06X\n", options->flash_len,
+           options->flash_addr);
+
+    if ((err = read_flash_range_from_remote(options->flash_addr,
+            options->flash_len, &flash, cb, cb_arg))) {
+        delete_blob(flash);
+        return err;
+    }
+
+    if ((err = write_safemode_to_file(flash, options->flash_len,
+            file_name))) {
+        delete_blob(flash);
+        return err;
+    }
+
+    delete_blob(flash);
+    return 0;
+}
+
 int upload_firmware(struct options_t *options, lc_callback cb, void *cb_arg)
 {
     int err;
@@ -968,7 +1026,7 @@ int main(int argc, char *argv[])
       * we have one, so lets read the file.
       */
     if (file_name && (mode != MODE_DUMP_CONFIG && mode != MODE_DUMP_FIRMWARE &&
-        mode != MODE_DUMP_SAFEMODE)) {
+        mode != MODE_DUMP_SAFEMODE && mode != MODE_DUMP_FLASH)) {
 
         int type;
         if ((err = read_and_parse_file(file_name, &type))) {
@@ -1022,7 +1080,8 @@ int main(int argc, char *argv[])
      * The is..supported() functions return 0 for yes, so 1 is NO
      */
     if ((mode == MODE_DUMP_CONFIG && is_config_dump_supported()) ||
-        ((mode == MODE_DUMP_FIRMWARE || mode == MODE_DUMP_SAFEMODE) &&
+        ((mode == MODE_DUMP_FIRMWARE || mode == MODE_DUMP_SAFEMODE ||
+          mode == MODE_DUMP_FLASH) &&
          is_fw_dump_supported())) {
         fprintf(stderr, "Sorry, that mode is not yet supported on your"
             " remote by libconcord.\n");
@@ -1123,6 +1182,14 @@ int main(int argc, char *argv[])
             }
             break;
 
+        case MODE_DUMP_FLASH:
+            err = dump_flash(&options, file_name, cb_print_percent_status,
+                             NULL);
+            if (err != 0) {
+                printf("Failed to dump flash: %s\n", lc_strerror(err));
+            }
+            break;
+
         case MODE_LEARN_IR:
             err = learn_ir_commands(&options, cb_print_percent_status, NULL);
             break;
diff --git a/libconcord/libconcord.cpp b/libconcord/libconcord.cpp
index 4e4e01d..c799722 100644
--- a/libconcord/libconcord.cpp
+++ b/libconcord/libconcord.cpp
@@ -421,6 +421,10 @@ const char *lc_cb_stage_str(int stage)
             return "Reading safemode fw";
             break;
 
+        case LC_CB_STAGE_READ_FLASH:
+            return "Reading flash";
+            break;
+
         case LC_CB_STAGE_RESET:
             return "Rebooting remote";
             break;
@@ -1384,6 +1388,32 @@ int read_safemode_from_remote(uint8_t **out, uint32_t *size, lc_callback cb,
         cb_arg, LC_CB_STAGE_READ_SAFEMODE);
 }
 
+int read_flash_range_from_remote(uint32_t addr, uint32_t size, uint8_t **out,
+                                 lc_callback cb, void *cb_arg)
+{
+    /* Flash commands carry a 24-bit address */
+    if (size == 0 || addr > 0xFFFFFF || size > 0x1000000 - addr) {
+        return LC_ERROR;
+    }
+
+    /*
+     * ReadFlash copies whole response packets, so it can run a few bytes
+     * past the requested length; pad the buffer for that.
+     */
+    *out = new uint8_t[size + 64];
+
+    if (!cb_arg) {
+        cb_arg = (void *)true;
+    }
+
+    if (rmt->ReadFlash(addr, size, *out, ri.protocol, false, cb, cb_arg,
+                       LC_CB_STAGE_READ_FLASH)) {
+        return LC_ERROR_READ;
+    }
+
+    return 0;
+}
+
 int write_safemode_to_file(uint8_t *in, uint32_t size, char *file_name)
 {
     binaryoutfile of;
diff --git a/libconcord/libconcord.h b/libconcord/libconcord.h
index ed58f69..f02d147 100644
--- a/libconcord/libconcord.h
+++ b/libconcord/libconcord.h
@@ -83,6 +83,7 @@
 #define LC_CB_STAGE_SET_TIME 19
 #define LC_CB_STAGE_HTTP 20
 #define LC_CB_STAGE_LEARN 21
+#define LC_CB_STAGE_READ_FLASH 22
 
 
 /*
@@ -361,6 +362,15 @@ int read_safemode_from_remote(uint8_t **out, uint32_t *size, lc_callback cb,
  * NOTE: You CAN NOT WRITE SAFEMODE FIRMWARE OVER USB!
  */
 
+/*
+ * Read an arbitrary range of flash from the remote, read-only. This is
+ * for backing up regions (e.g. the full arch 14 firmware) that the other
+ * dump functions don't cover. Use delete_blob to reclaim the memory, and
+ * write_safemode_to_file to save it as pure binary.
+ */
+int read_flash_range_from_remote(uint32_t addr, uint32_t size, uint8_t **out,
+                                 lc_callback cb, void *cb_arg);
+
 /*
  * Write aforementioned safemode data to a file. Note that this is always
  * written as pure binary.
-- 
