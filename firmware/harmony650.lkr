// Linker script for custom Harmony 650 application firmware.
// The bootloader owns 0x0000-0x8FFF and copies at most 0x15C00 bytes to
// 0x9000, then jumps to 0x900A after checking the header checksum. Its
// interrupt vectors jump to 0x9400 (high) and 0x9800 (low).

LIBPATH .

CODEPAGE   NAME=header     START=0x9000            END=0x900D         PROTECTED
CODEPAGE   NAME=code0      START=0x900E            END=0x93FF
CODEPAGE   NAME=hivec      START=0x9400            END=0x9407         PROTECTED
CODEPAGE   NAME=code1      START=0x9408            END=0x97FF
CODEPAGE   NAME=lovec      START=0x9800            END=0x9807         PROTECTED
CODEPAGE   NAME=code2      START=0x9808            END=0x1EBFF

ACCESSBANK NAME=accessram  START=0x0               END=0x5F
DATABANK   NAME=gpr0       START=0x60              END=0xFF
// 0x100 is the bootloader's update flag (2 or 6 = copy external flash to
// internal at reset); keep the whole bank out of the allocator.
DATABANK   NAME=gpr1       START=0x100             END=0x1FF          PROTECTED
DATABANK   NAME=gpr2       START=0x200             END=0x2FF
DATABANK   NAME=gpr3       START=0x300             END=0x3FF
// USB RAM: buffer descriptors and endpoint buffers, placed with __at()
DATABANK   NAME=usbram     START=0x400             END=0x7FF          PROTECTED
DATABANK   NAME=gpr8       START=0x800             END=0x8FF
DATABANK   NAME=gpr9       START=0x900             END=0x9FF
DATABANK   NAME=gpr10      START=0xA00             END=0xAFF
DATABANK   NAME=gpr11      START=0xB00             END=0xBFF
DATABANK   NAME=gpr12      START=0xC00             END=0xCFF
DATABANK   NAME=gpr13      START=0xD00             END=0xDFF
DATABANK   NAME=gpr14      START=0xE00             END=0xEFF
DATABANK   NAME=gpr15      START=0xF00             END=0xF3F
DATABANK   NAME=sfr15      START=0xF40             END=0xF5F          PROTECTED
ACCESSBANK NAME=accesssfr  START=0xF60             END=0xFFF          PROTECTED
