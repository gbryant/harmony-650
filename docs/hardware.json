  "update_sequence_logitech": {
    "steps": [
      "unless Safe mode (firmware type 4): RestartConfig = A3 0A 09 00",
      "set RAM[0] = 0 and read back",
      "invalidate flash (A1 02), erase 64 KiB sectors, write the image at external 0x0, read back and compare",
      "set RAM[0] = 2 and read back",
      "reset"
    ],
    "implementation": "concordance --write-arch14-fw=<image> [--commit] (concordance-patches/)",
    "status": "tested"
  },
