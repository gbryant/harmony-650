    "interface": {
      "type": "4-wire SPI on MSSP2, mode 3 (clock idles high), Fosc/4",
      "SSP2STAT": "0x00",
      "SSP2CON1": "0x30",
      "pins": {
        "SDA": "RD4 (SDO2; input during ID reads)",
        "SCL": "RD6 (SCK2)",
        "CS": "RD7 (active low)",
        "DC": "RB3 (low = command)",
        "RESET": "RF6 (active low)"
