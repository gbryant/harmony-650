  "custom_usb_protocol": {
    "input_report": {
      "size": 8,
      "layout": [
        "pressed (1/0)",
        "column",
        "row",
        "code",
        "sequence"
      ],
      "info_report": {
        "byte0": "0x80",
        "layout": [
          "0x80",
          "LCD ID3",
          "LCD ID1",
          "Timer0 ticks/ms low",
          "sequence",
          "ticks high",
          "LATG",
          "display packets processed"
        ]
      }
    },
    "output_report": {
      "size": 64,
      "commands": {
        "1": "WINDOW x0 y0 x1 y1",
        "2": "PIXELS n data[n<=62]",
        "3": "FILL x0 y0 x1 y1 hi lo",
        "4": "BACKLIGHT flags (bit0 screen, bit1 buttons)",
        "5": "RUNS n (count hi lo)[n<=20], count 0 = 256",
        "6": "INFO"
      }
    },
    "throughput": "one 64-byte packet per 1 ms USB frame; ~0.3 s typical full frame, 0.53 s worst case",
    "status": "tested"
  },
  "config_format": {
    "file": ".EZHex = XML header + binary (<BINARYDATASIZE> bytes, identical to flash at 0x30000)",
    "binary": "\"GSPM\", 24-bit LE end address at offset 4; at end-2 an XOR-word checksum seeded 0x21,0x43 over [0, end-2); then \"PTYY\"",
    "file_checksum": "<CHECKSUM> = 0x69 XOR every binary byte",
