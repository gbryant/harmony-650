    "panel_detection": {
      "method": "bit-banged 3-wire read with MSSP2 off: command, then 8 bits sampled on RD4; each ID read twice",
      "rule": "ID3 (0xDC) != 0 -> second controller family (stock init at 0xD9C2, 16-bit window addresses with +1/+2 offsets); else ID1 (0xDA) = 1 or 2 -> ST7637 variants 1/2, other -> variant 3",
